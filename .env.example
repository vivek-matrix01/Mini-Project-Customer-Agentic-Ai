# ============================================================
# Nexus AI — Environment Variables Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file to .env  (git-ignored)
#   2. Fill in your real values
#   3. NEVER commit .env to git
# ============================================================

# ── Database (PostgreSQL) ─────────────────────────────────────
POSTGRES_DB=MiniProject
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/MiniProject
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# ── JWT ───────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-secure-random-32-char-secret-key

# ── LLM Providers ─────────────────────────────────────────────
# Provider chain: Groq (primary) → Gemini (secondary) → Ollama (local fallback)
# Set only the keys you have — unused providers are skipped automatically.

# Groq — FREE tier, fastest (LPU hardware), ~300ms response
# Get key at: https://console.groq.com (no credit card needed)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini — FREE tier, secondary fallback
# Get key at: https://aistudio.google.com (no credit card needed)
GOOGLE_API_KEY=your_google_api_key_here

# Ollama — local fallback (no key needed, must be running locally)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral

# ── Service URLs (internal docker-compose network) ────────────
AI_SERVICE_URL=http://ai-service:8000/analyze
AI_CHAT_URL=http://ai-service:8000/chat
