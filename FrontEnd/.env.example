# ── Vite Environment Variables ────────────────────────────────────────────────
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Copy this to .env.local for local dev (git-ignored by default).
#
# For Vercel deployment: add this in Vercel → Project Settings → Env Variables

# URL of your deployed Spring Boot backend (Railway / Render)
# Local default: http://localhost:8080
# NOTE: All AI interactions (reviews and admin chat) are proxied securely
# through the Spring Boot API Gateway. Frontend only needs VITE_BACKEND_URL!
VITE_BACKEND_URL=http://localhost:8080
