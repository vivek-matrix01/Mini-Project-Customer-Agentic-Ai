# ── Vite Environment Variables ────────────────────────────────────────────────
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Copy this to .env.local for local dev (git-ignored by default).
#
# For Vercel deployment: add these in Vercel → Project Settings → Env Variables

# URL of your deployed Spring Boot backend (Railway)
# Local default: http://localhost:8080
VITE_BACKEND_URL=http://localhost:8080

# URL of your deployed Python AI service (Railway)
# Local default: http://localhost:8000
VITE_AI_SERVICE_URL=http://localhost:8000
